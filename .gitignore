# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary validation screenshots / artifacts
tmp_*.png
tmp_*.jpg
tmp_*.blend
tmp_*.svg
tmp_*.zip

# Blender auto-backup files
*.blend1

# C extensions
*.so

# Bridge packages generated during tests/spikes
bridge_package/
*.bridge.zip

