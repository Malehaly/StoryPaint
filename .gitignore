spikes/
tools/

# Internal planning docs, agent notes and workspace config (not public)
docs/
AGENTS.md
.vscode/

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
